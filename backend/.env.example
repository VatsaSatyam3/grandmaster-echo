# ── Database ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/grandmaster_echo

# ── Stockfish ──────────────────────────────────────────────────────────
STOCKFISH_PATH=/usr/bin/stockfish
STOCKFISH_DEPTH=18
STOCKFISH_THREADS=2
STOCKFISH_HASH=256

# ── OpenAI / LLM ──────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here

# ── Langfuse (optional) ───────────────────────────────────────────────
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com

# ── External chess APIs ───────────────────────────────────────────────
CHESS_COM_API_BASE=https://api.chess.com/pub/player
LICHESS_API_BASE=https://lichess.org/api

# ── Analysis tunables ─────────────────────────────────────────────────
MAX_GAMES=200
BLUNDER_THRESHOLD=2.0
