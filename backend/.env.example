# ── Database ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/grandmaster_echo

# ── Stockfish ──────────────────────────────────────────────────────────
STOCKFISH_PATH=/usr/bin/stockfish
STOCKFISH_DEPTH=18
STOCKFISH_THREADS=2
STOCKFISH_HASH=256

# ── Gemini (primary LLM + embeddings) ─────────────────────────────────
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ── Groq (OpenAI-compatible fallback, fast structured output) ─────────
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ── OpenAI / LLM fallback ─────────────────────────────────────────────
OPENAI_API_KEY=

# ── Qdrant vector store (RAG over player move histories) ──────────────
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
QDRANT_COLLECTION=grandmaster_echo_moves
ENABLE_RAG=true
RAG_TOP_K=5
EMBEDDING_DIM=768

# ── Langfuse (optional) ───────────────────────────────────────────────
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com

# ── External chess APIs ───────────────────────────────────────────────
CHESS_COM_API_BASE=https://api.chess.com/pub/player
LICHESS_API_BASE=https://lichess.org/api

# ── Analysis tunables ─────────────────────────────────────────────────
MAX_GAMES=200
BLUNDER_THRESHOLD=2.0
